# ===================================================================
# UMSA - Centro Médico
# Plantilla de variables de entorno para producción (.env.example)
# Copiá este archivo como '.env' y completá con tus valores reales.
# NUNCA subas el archivo '.env' con secretos reales a Git.
# ===================================================================

# Clave secreta de Django (generar una cadena aleatoria y segura)
SECRET_KEY=cambiar-por-una-clave-secreta-muy-segura-en-produccion

# Modo depuración (en producción SIEMPRE debe ser False)
DEBUG=False

# Dominios permitidos separados por comas (sin protocolo ni barras)
ALLOWED_HOSTS=midominio.com,www.midominio.com,localhost,127.0.0.1

# Orígenes confiables para protección CSRF en HTTPS separados por comas
CSRF_TRUSTED_ORIGINS=https://midominio.com,https://www.midominio.com

# Base de datos local (SQLite por defecto)
USE_SQLITE=True
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
